[Desktop Entry]
Type=Service
MimeType=image/jpeg;image/png;image/webp;image/heif;image/heic;image/avif;image/bmp;image/tiff;
Actions=resize;
X-KDE-Priority=TopLevel

[Desktop Action resize]
Name=Compress with ImageResizerJ
Name[ru]=Сжать с ImageResizerJ
Icon=imageresizej
Exec=/usr/bin/resizer-worker %F